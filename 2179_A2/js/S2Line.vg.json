{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 540,
  "height": 400,

  "data": {
    "url": "https://raw.githubusercontent.com/Joey6-z/fit2179/refs/heads/main/2179_A2/data/sight-loss-over-time.csv"
  },

  "params": [
    {
      "name": "gender_select",
      "value": "total",
      "bind": {
        "input": "select",
        "name": "Gender: ",
        "options": ["total", "female", "male"]
      }
    },
    {
      "name": "year_select",
      "value": 2020,
      "bind": {
        "input": "range",
        "name": "Compare Year: ",
        "min": 2000,
        "max": 2020,
        "step": 10
      }
    }
  ],

  "transform": [
    {
      "calculate": "toNumber(datum.Year)",
      "as": "Year"
    },
    {
      "filter": "datum.gender == gender_select"
    },
    {
      "filter": "datum.Year == 1990 || datum.Year == year_select"
    },
    {
      "fold": [
        "Blindness",
        "Moderate-severe",
        "Mild",
        "Near"
      ],
      "as": ["Severity", "Value"]
    },

    {
      "calculate": "datum.Severity == 'Moderate-severe' ? 'Moderate' : datum.Severity",
      "as": "SeverityLabel"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 4
      },

      "encoding": {
        "x": {
          "field": "Year",
          "type": "quantitative",
          "axis": {
            "values": [1990, 2000, 2010, 2020],
            "title": null,
            "labelAngle": 0,
            "labelFontSize": 13,
            "domain": false,
            "ticks": false,
            "grid": false,
            "format": "d"
          }
        },

        "y": {
          "field": "Value",
          "type": "quantitative",
          "axis": {
            "title": "Number of Cases",
            "titleFontSize": 16,
            "labelFontSize": 13,
            "gridColor": "#ececec"
          }
        },

        "color": {
          "field": "Severity",
          "type": "nominal",
          "scale": {
            "domain": [
              "Blindness",
              "Moderate-severe",
              "Mild",
              "Near"
            ],
            "range": [
              "#ffb3c6",
              "#cdb4db",
              "#90dbf4",
              "#5e81ac"
            ]
          },
          "legend": {
            "title": "Severity Level",
            "orient": "top",
            "symbolStrokeWidth": 4,
            "symbolSize": 250,
            "labelFontSize": 13,
            "titleFontSize": 15
          }
        },

        "detail": {
          "field": "Severity"
        },

        "tooltip": [
          { "field": "Severity", "type": "nominal" },
          { "field": "Year", "type": "quantitative" },
          { "field": "Value", "type": "quantitative", "title": "Cases" },
          { "field": "gender", "type": "nominal" }
        ]
      }
    },

    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 90
      },

      "encoding": {
        "x": { "field": "Year", "type": "quantitative" },
        "y": { "field": "Value", "type": "quantitative" },

        "color": {
          "field": "Severity",
          "type": "nominal",
          "legend": null
        },

        "tooltip": [
          { "field": "Severity", "type": "nominal" },
          { "field": "Year", "type": "quantitative" },
          { "field": "Value", "type": "quantitative" }
        ]
      }
    },

    {
      "transform": [
        { "filter": "datum.Year == year_select" }
      ],

      "mark": {
        "type": "text",
        "align": "left",
        "dx": 12,
        "fontSize": 14,
        "fontWeight": "bold"
      },

      "encoding": {
        "x": { "field": "Year", "type": "quantitative" },
        "y": { "field": "Value", "type": "quantitative" },

        "text": {
          "field": "SeverityLabel"
        },

        "color": {
          "field": "Severity",
          "type": "nominal",
          "legend": null
        }
      }
    }
  ],

  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    }
  }
}