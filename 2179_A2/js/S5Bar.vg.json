{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 500,
  "height": 420,
  "data": {
    "url": "https://raw.githubusercontent.com/Joey6-z/fit2179/refs/heads/main/2179_A2/data/S5_productivity-loss-due-to-poor-vision-per-year.csv",
    "format": {"type": "csv", "parse": {"Value": "number"}}
  },
  "transform": [
    {
      "calculate": "datum.Value / 1000000000",
      "as": "ValueB"
    },
    {
      "calculate": "datum.Category == 'Global (GNI)' ? 'Global (Gross National Income)' : datum.Category == 'Global (Min Wage)' ? 'Global (Minimum Wage)' : datum.Category",
      "as": "CategoryLabel"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusTopLeft": 6,
        "cornerRadiusTopRight": 6
      },
      "encoding": {
        "x": {
  "field": "Category",
  "type": "nominal",
  "scale": {"paddingInner": 0.3},
  "axis": {
    "title": null,
    "labelFontSize": 12,
    "labelFontWeight": "bold",
    "labelAngle": -30,
    "domain": false,
    "ticks": false
  }
},
        "y": {
          "field": "ValueB",
          "type": "quantitative",
          "axis": {
            "title": "Productivity Loss (USD Billion)",
            "titleFontSize": 14,
            "labelFontSize": 12,
            "gridColor": "#ececec",
            "format": "$,.0f"
          }
        },
        "color": {
          "field": "Severity",
          "type": "nominal",
          "scale": {
            "domain": ["Blindness", "Moderate-severe"],
            "range": ["#a9def9", "#d4c1ec"]
          },
          "legend": {
            "title": "Severity",
            "orient": "top",
            "labelFontSize": 12,
            "titleFontSize": 13
          }
        },
        "xOffset": {
          "field": "Severity",
          "type": "nominal"
        },
        "tooltip": [
          {"field": "CategoryLabel", "type": "nominal", "title": "Region"},
          {"field": "Severity", "type": "nominal", "title": "Severity"},
          {"field": "ValueB", "type": "quantitative", "title": "Loss (USD Billion)", "format": "$,.2f"}
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [{"op": "sum", "field": "ValueB", "as": "TotalB"}],
          "groupby": ["Category"]
        }
      ],
      "mark": {
        "type": "text",
        "dy": -8,
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "#666"
      },
      "encoding": {
        "x": {"field": "Category", "type": "nominal"},
        "y": {"field": "TotalB", "type": "quantitative"},
        "text": {"field": "TotalB", "type": "quantitative", "format": "$,.2f"}
      }
    },
    {
  "mark": {
    "type": "text",
    "align": "left",
    "fontSize": 13,
    "fontStyle": "italic",
    "color": "#873535",
    "lineBreak": "\n"
  },
  "encoding": {
    "x": {"value": 315},
    "y": {"value": 15},
    "text": {"value": "Min Wage & GNI represent the lower and upper\nbounds of estimated productivity loss,\nreflecting different assumptions about\nthe economic value of lost work."}
  }
}
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": null}
  }
}