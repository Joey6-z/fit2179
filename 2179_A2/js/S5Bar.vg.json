{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 500,
  "height": 420,
  "data": {
    "values": [
      {"Category": "Blindness", "Value": 650000000},
      {"Category": "Moderate-severe", "Value": 4947000000}
    ]
  },
  "transform": [
    {
      "calculate": "datum.Value / 1000000000",
      "as": "ValueB"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusTopLeft": 6,
        "cornerRadiusTopRight": 6
      },
      "encoding": {
        "x": {
          "field": "Category",
          "type": "nominal",
          "axis": {
            "title": null,
            "labelFontSize": 14,
            "labelFontWeight": "bold",
            "domain": false,
            "ticks": false
          }
        },
        "y": {
          "field": "ValueB",
          "type": "quantitative",
          "axis": {
            "title": "Productivity Loss (USD Billion)",
            "titleFontSize": 14,
            "labelFontSize": 12,
            "gridColor": "#ececec",
            "format": "$,.2f"
          }
        },
        "color": {
          "field": "Category",
          "type": "nominal",
          "scale": {
            "domain": ["Blindness", "Moderate-severe"],
            "range": ["#a9def9", "#d4c1ec"]
          },
          "legend": null
        },
        "tooltip": [
          {"field": "Category", "type": "nominal", "title": "Severity"},
          {"field": "ValueB", "type": "quantitative", "title": "Loss (USD Billion)", "format": "$,.2f"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -10,
        "fontSize": 13,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {"field": "Category", "type": "nominal"},
        "y": {"field": "ValueB", "type": "quantitative"},
       "text": {"field": "ValueB", "type": "quantitative", "format": "$,.2f"},
        "color": {
          "field": "Category",
          "type": "nominal",
          "scale": {
            "domain": ["Blindness", "Moderate-severe"],
            "range": ["#a9def9", "#d4c1ec"]
          },
          "legend": null
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "strokeDash": [4, 4],
        "color": "#999",
        "strokeWidth": 1.5
      },
      "encoding": {
        "y": {"datum": 5.597}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -10,
        "dy": -8,
        "fontSize": 12,
        "fontStyle": "italic",
        "color": "#666"
      },
      "encoding": {
        "x": {"value": 400},
        "y": {"datum": 5.597},
        "text": {"value": "Total: $5.60B / year"}
      }
    }
  ],
  "config": {
    "background": "white",
    "view": {"stroke": null}
  }
}