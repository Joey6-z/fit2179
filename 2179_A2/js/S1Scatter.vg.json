{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "description": "Interactive scatter plot with dropdown and brush zoom",

  "data": {
    "url": "https://raw.githubusercontent.com/Joey6-z/fit2179/refs/heads/main/2179_A2/2179_A2/data/eye_score.csv"
  },

  "params": [
    {
      "name": "HabitSelector",
      "value": "screen_time_hours",
      "bind": {
        "input": "select",
        "options": [
          "screen_time_hours",
          "screen_brightness_avg",
          "screen_distance_cm",
          "night_mode_usage"
        ],
        "labels": [
          "Screen Time Hours",
          "Screen Brightness Average",
          "Screen Distance (cm)",
          "Night Mode Usage (%)"
        ],
        "name": "Screen Habit: "
      }
    }
  ],

  "transform": [
    {
      "calculate": "datum[HabitSelector]",
      "as": "SelectedHabit"
    }
  ],

  "vconcat": [
    {
      "width": 700,
      "height": 500,

      "mark": {
        "type": "point",
        "filled": true,
        "size": 80,
        "opacity": 0.7
      },

      "encoding": {
        "x": {
          "field": "SelectedHabit",
          "type": "quantitative",
          "title":  "Selected Screen Habit"
        },

        "y": {
          "field": "eye_health_score",
          "type": "quantitative",
          "title": "Eye Health Score",
          "scale": {
            "domain": {
              "param": "brush"
            }
          }
        },

        "color": {
          "field": "eye_health_score",
          "type": "quantitative"
        },

        "tooltip": [
          {
            "field": "eye_health_score",
            "type": "quantitative"
          },
          {
            "field": "screen_time_hours",
            "type": "quantitative"
          },
          {
            "field": "screen_brightness_avg",
            "type": "quantitative"
          },
          {
            "field": "screen_distance_cm",
            "type": "quantitative"
          },
          {
            "field": "night_mode_usage",
            "type": "quantitative"
          }
        ]
      }
    },

    {
      "width": 700,
      "height": 100,

      "mark": {
        "type": "point",
        "filled": true,
        "size": 30,
        "opacity": 0.4
      },

      "params": [
        {
          "name": "brush",
          "select": {
            "type": "interval",
            "encodings": ["y"]
          }
        }
      ],

      "encoding": {
        "x": {
          "field": "SelectedHabit",
          "type": "quantitative"
        },

        "y": {
          "field": "eye_health_score",
          "type": "quantitative"
        }
      }
    }
  ]
}